#!/bin/sh
# postinst — exécuté après l'installation du paquet anonymous-server.
# Crée un utilisateur système dédié, sans shell de connexion, et pose
# des permissions restrictives sur les répertoires de données.

set -e

ANON_USER="anonymous"
ANON_GROUP="anonymous"
DATA_DIR="/var/lib/anonymous"
LOG_DIR="/var/log/anonymous"
CONFIG_DIR="/etc/anonymous"

if ! getent group "$ANON_GROUP" >/dev/null 2>&1; then
    addgroup --system "$ANON_GROUP"
fi

if ! getent passwd "$ANON_USER" >/dev/null 2>&1; then
    adduser --system --ingroup "$ANON_GROUP" --home "$DATA_DIR" \
        --no-create-home --shell /usr/sbin/nologin \
        --gecos "Anonymous server" "$ANON_USER"
fi

mkdir -p "$DATA_DIR" "$DATA_DIR/files" "$LOG_DIR"

chown -R "$ANON_USER:$ANON_GROUP" "$DATA_DIR" "$LOG_DIR"
chmod 0700 "$DATA_DIR" "$DATA_DIR/files" "$LOG_DIR"

# La configuration reste lisible par le groupe dédié uniquement — elle
# peut contenir un hash de mot de passe (Argon2id, jamais le mot de
# passe en clair, mais on reste prudent). Le paquet livre
# server.toml en 0644 (voir build.sh : tous les fichiers du paquet
# sont chmodés 0644 par défaut à la construction, aucun traitement
# spécial pour celui-ci) — c'est CE bloc, exécuté à l'installation,
# qui doit impérativement le resserrer.
#
# Bug réel corrigé : les `chown`/`chmod` ci-dessous avalaient
# silencieusement toute erreur (`|| true`), donc un échec (droits
# insuffisants, SELinux, etc.) laissait le fichier root:root 0644 —
# lisible par n'importe quel utilisateur du système — SANS que
# l'installation ne le signale. Les commandes sont désormais
# bloquantes (`set -e` en tête de script) : un échec fait échouer
# l'installation au lieu de se terminer avec des permissions fausses.
#
# On applique aussi ces permissions au DOSSIER lui-même (pas que
# server.toml par son nom) : tout fichier de config supplémentaire
# placé dans $CONFIG_DIR par la suite (ex. une liste de mots
# bannis, voir [moderation] dans server.toml) hérite de la même
# protection sans avoir besoin d'un ajout manuel ici.
chown root:"$ANON_GROUP" "$CONFIG_DIR"
chmod 0750 "$CONFIG_DIR"
if [ -d "$CONFIG_DIR" ]; then
    find "$CONFIG_DIR" -maxdepth 1 -type f -exec chown root:"$ANON_GROUP" {} \;
    find "$CONFIG_DIR" -maxdepth 1 -type f -exec chmod 0640 {} \;
fi

systemctl daemon-reload >/dev/null 2>&1 || true

echo "Anonymous server installé."
echo "Configurez /etc/anonymous/server.toml puis lancez :"
echo "  sudo systemctl enable --now anonymous-server"

exit 0
